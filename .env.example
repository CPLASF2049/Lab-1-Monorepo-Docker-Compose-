# Lab 1 - Monorepo + Docker Compose multi-container application
#
# Copy this file to .env and adjust the values if needed:
#   cp .env.example .env
# The defaults below work out of the box for a local Docker host.

# ---- Frontend -------------------------------------------------------------
# Host port that publishes the frontend container. Open http://localhost:${FRONTEND_PORT}
FRONTEND_PORT=8080

# ---- Backend --------------------------------------------------------------
# Backend port INSIDE the container (the backend is not published to the host).
BACKEND_PORT=3000
# How long the backend keeps retrying the database connection on startup.
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_DELAY_MS=2000

# ---- Database -------------------------------------------------------------
POSTGRES_DB=counterdb
POSTGRES_USER=counter
POSTGRES_PASSWORD=counter
# Host port for optional external access with a database client.
# 5432 may already be in use by a local PostgreSQL installation.
DB_PORT=5432

# ---- Compose project ------------------------------------------------------
# Changing this name changes the "{project}_{volume}" name of the data volume,
# which would make an existing counter appear to be lost.
COMPOSE_PROJECT_NAME=lab1-counter
